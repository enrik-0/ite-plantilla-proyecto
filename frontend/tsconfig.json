{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true, // ponytail: typecheck only; vite build emits the bundle
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src"]
}
